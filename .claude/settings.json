{
  "permissions": {
    "allow": [
      "Bash(go:*)",
      "Bash(just:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(git:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(golangci-lint:*)"
    ],
    "ask": [
      "WebSearch",
      "Bash(rm -rf *)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)"
    ],
    "deny": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "gofmt"
          }
        ]
      }
    ]
  }
}
